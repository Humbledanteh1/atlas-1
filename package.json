{
  "name": "atlas-1",
  "version": "0.1.0",
  "private": false,
  "description": "Privacy-preserving multi-tenant client-data gateway with OIDC authentication and PostgreSQL RLS guidance",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jose": "6.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

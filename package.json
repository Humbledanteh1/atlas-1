{
  "name": "atlas-1",
  "version": "0.1.0",
  "private": false,
  "description": "Privacy-preserving multi-tenant client-data gateway with OIDC authentication and PostgreSQL RLS guidance",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jose": "6.2.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}

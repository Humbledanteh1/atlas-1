# Authentication mode: "hmac" is the local prototype fallback; "oidc" uses a remote JWKS.
FOLKLORE_AUTH_MODE=oidc

# OIDC provider settings. The issuer must exactly match the token's iss claim.
# Auth0 example: https://YOUR_DOMAIN/
# Keycloak example: https://YOUR_KEYCLOAK_HOST/realms/YOUR_REALM
FOLKLORE_OIDC_ISSUER=https://idp.example.com/
FOLKLORE_OIDC_AUDIENCE=https://api.example.com
# Auth0: https://YOUR_DOMAIN/.well-known/jwks.json
# Keycloak: https://YOUR_KEYCLOAK_HOST/realms/YOUR_REALM/protocol/openid-connect/certs
FOLKLORE_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
FOLKLORE_OIDC_TENANT_CLAIM=https://folklore.example/tenant_id
FOLKLORE_OIDC_REQUIRED_SCOPE=needs:submit

# Dedicated secret for tenant-bound opaque client references. Required in production.
FOLKLORE_REFERENCE_SECRET=replace-with-a-second-secret-managed-outside-the-repository

# Optional local allowlist. In production, replace this with an active-tenant database check.
FOLKLORE_ACTIVE_TENANTS=tenant-alpha,tenant-beta

# Only needed when FOLKLORE_AUTH_MODE=hmac. Never commit the real value.
FOLKLORE_AUTH_SECRET=replace-with-a-secret-managed-outside-the-repository
